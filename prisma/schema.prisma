generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ANALYST
  VIEWER
}

enum QuoteSourceType {
  MANUAL
  WEB_LINK
}

enum QuoteStatus {
  IMPORTED_PENDING_REVIEW
  APPROVED
  REJECTED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  vendors   Vendor[]
  products  Product[]
  quotes    PriceQuote[]
  auditLogs AuditLog[]
}

model User {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  email          String   @unique
  passwordHash   String
  role           UserRole
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  createdQuotes PriceQuote[] @relation("QuoteCreatedBy")
  reviewedQuotes PriceQuote[] @relation("QuoteReviewedBy")
  auditLogs      AuditLog[]

  @@index([organizationId])
}

model Vendor {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  country        String
  email          String?
  whatsapp       String?
  website        String?
  notes          String?
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  quotes        PriceQuote[]

  @@index([organizationId])
  @@index([name])
}

model ProductCategory {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  products      Product[]

  @@index([organizationId])
}

model Product {
  id             String   @id @default(uuid())
  organizationId String
  categoryId     String?
  name           String
  sku            String?
  unit           String   @default("un")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  category     ProductCategory? @relation(fields: [categoryId], references: [id])
  priceLines   PriceQuoteLine[]

  @@index([organizationId])
  @@index([name])
}

model PriceQuote {
  id             String        @id @default(uuid())
  organizationId String
  vendorId       String
  currency       String
  validFrom      DateTime?
  validTo        DateTime
  status         QuoteStatus   @default(IMPORTED_PENDING_REVIEW)
  sourceType     QuoteSourceType
  sourceUrl      String?
  sourceReference String?
  notes          String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdByUserId  String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  vendor       Vendor @relation(fields: [vendorId], references: [id])
  createdBy    User @relation("QuoteCreatedBy", fields: [createdByUserId], references: [id])
  reviewedBy   User? @relation("QuoteReviewedBy", fields: [reviewedByUserId], references: [id])
  priceLines   PriceQuoteLine[]
  attachments  QuoteAttachment[]

  @@index([organizationId])
  @@index([vendorId])
}

model PriceQuoteLine {
  id           String   @id @default(uuid())
  priceQuoteId String
  productId    String
  unitPrice    Decimal
  minOrderQty  Int?
  leadTimeDays Int?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  priceQuote PriceQuote @relation(fields: [priceQuoteId], references: [id])
  product    Product @relation(fields: [productId], references: [id])

  @@index([priceQuoteId])
  @@index([productId])
}

model QuoteAttachment {
  id           String   @id @default(uuid())
  priceQuoteId String
  fileName     String
  fileUrl      String
  createdAt    DateTime @default(now())

  priceQuote PriceQuote @relation(fields: [priceQuoteId], references: [id])

  @@index([priceQuoteId])
}

model AuditLog {
  id             String      @id @default(uuid())
  organizationId String
  entityType     String
  entityId       String
  action         AuditAction
  beforeJson     Json?
  afterJson      Json?
  userId         String?
  ipAddress      String?
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User? @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([entityType, entityId])
}
