generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
  AUDITOR
}

enum QuoteSourceType {
  MANUAL
  WEB_LINK
}

enum QuoteStatus {
  IMPORTED_PENDING_REVIEW
  APPROVED
  REJECTED
}

enum RolloverRisk {
  LOW
  MEDIUM
  HIGH
}

enum ChargeGroup {
  ORIGIN
  OCEAN
  DESTINATION
}

enum ChargeType {
  FIXED
  PER_CONTAINER
  PER_TON
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  suppliers  Supplier[]
  ports      Port[]
  routes     Route[]
  quotes     FreightQuote[]
  auditLogs  AuditLog[]
}

model User {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  email          String   @unique
  passwordHash   String
  role           UserRole
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  createdQuotes FreightQuote[] @relation("QuoteCreatedBy")
  reviewedQuotes FreightQuote[] @relation("QuoteReviewedBy")
  auditLogs AuditLog[]

  @@index([organizationId])
}

model Supplier {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  country        String
  email          String?
  whatsapp       String?
  website        String?
  notes          String?
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  quotes        FreightQuote[]

  @@index([organizationId])
  @@index([name])
}

model Port {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  country        String
  code           String?
  type           String   @default("sea")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  originRoutes  Route[] @relation("OriginPort")
  destinationRoutes Route[] @relation("DestinationPort")
  originQuotes  FreightQuote[] @relation("OriginPortQuote")
  destinationQuotes FreightQuote[] @relation("DestinationPortQuote")

  @@index([organizationId])
  @@index([country])
}

model ContainerType {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Route {
  id             String   @id @default(uuid())
  organizationId String
  originPortId   String
  destinationPortId String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  originPort   Port @relation("OriginPort", fields: [originPortId], references: [id])
  destinationPort Port @relation("DestinationPort", fields: [destinationPortId], references: [id])

  @@index([organizationId])
  @@unique([organizationId, originPortId, destinationPortId])
}

model FreightQuote {
  id                     String        @id @default(uuid())
  organizationId         String
  supplierId             String
  originPortId           String
  destinationPortId      String
  carrier                String?
  service                String?
  incoterm               String?
  currency               String
  validityStart          DateTime?
  validityEnd            DateTime
  transitTimeDays        Int?
  rolloverRisk           RolloverRisk?
  rolloverNotes          String?
  freeTimeOriginDays     Int?
  freeTimeDestinationDays Int?
  observations           String?
  sourceType             QuoteSourceType
  sourceUrl              String?
  sourceReference        String?
  status                 QuoteStatus   @default(IMPORTED_PENDING_REVIEW)
  reviewedByUserId       String?
  reviewedAt             DateTime?
  createdByUserId        String
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  supplier     Supplier @relation(fields: [supplierId], references: [id])
  originPort   Port @relation("OriginPortQuote", fields: [originPortId], references: [id])
  destinationPort Port @relation("DestinationPortQuote", fields: [destinationPortId], references: [id])
  createdBy    User @relation("QuoteCreatedBy", fields: [createdByUserId], references: [id])
  reviewedBy   User? @relation("QuoteReviewedBy", fields: [reviewedByUserId], references: [id])
  costLines    FreightQuoteCost[]
  attachments  QuoteAttachment[]

  @@index([organizationId])
  @@index([supplierId])
  @@index([originPortId, destinationPortId])
}

model FreightQuoteCost {
  id             String      @id @default(uuid())
  freightQuoteId String
  group          ChargeGroup
  chargeName     String
  chargeType     ChargeType?
  amount20gp     Decimal?
  amount40hc     Decimal?
  amount40nor    Decimal?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  freightQuote FreightQuote @relation(fields: [freightQuoteId], references: [id])

  @@index([freightQuoteId])
}

model QuoteAttachment {
  id             String   @id @default(uuid())
  freightQuoteId String
  fileName       String
  fileUrl        String
  createdAt      DateTime @default(now())

  freightQuote FreightQuote @relation(fields: [freightQuoteId], references: [id])

  @@index([freightQuoteId])
}

model AuditLog {
  id             String      @id @default(uuid())
  organizationId String
  entityType     String
  entityId       String
  action         AuditAction
  beforeJson     Json?
  afterJson      Json?
  userId         String?
  ipAddress      String?
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User? @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([entityType, entityId])
}
